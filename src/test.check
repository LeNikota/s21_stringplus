#test s21_strncat_1
    char str1[100] = "Hello";
    char str2[100] = "Hello";
    const char src[] = " World!";
    
    strncat(str1, src, 6);
    s21_strncat(str2, src, 6);
    
    ck_assert_str_eq(str1, str2);

#test s21_strncat_2
    char str3[100] = "Goodbye";
    char str4[100] = "Goodbye";
    const char src2[] = " Cruel World!";
    
    strncat(str3, src2, 10);
    s21_strncat(str4, src2, 10);
    
    ck_assert_str_eq(str3, str4);

#test s21_strncat_3
    char str5[100] = "Test";
    char str6[100] = "Test";
    const char src3[] = " String Concatenation";
    
    strncat(str5, src3, 80);
    s21_strncat(str6, src3, 80);
    
    ck_assert_str_eq(str5, str6);






#test s21_strncmp_1
    const char str1[] = "Hello";
    const char str2[] = "Hello";
    
    ck_assert_int_eq(s21_strncmp(str1, str2, 5), strncmp(str1, str2, 5));

#test s21_strncmp_2
    const char str1[] = "Hello";
    const char str2[] = "World";
    
    ck_assert_int_eq(s21_strncmp(str1, str2, 5), strncmp(str1, str2, 5));

#test s21_strncmp_4
    const char str1[] = "Hello";
    const char str2[] = "Hello, World";
    
    ck_assert_int_eq(s21_strncmp(str1, str2, 10), strncmp(str1, str2, 10));

#test s21_strncmp_5
    const char str1[] = "Hello, World";
    const char str2[] = "Hello";
    
    ck_assert_int_eq(s21_strncmp(str1, str2, 10), strncmp(str1, str2, 10));

#test s21_strncmp_6
    const char str1[] = "Hello";
    const char str2[] = "Hello";
    
    ck_assert_int_eq(s21_strncmp(str1, str2, 0), strncmp(str1, str2, 0));

#test s21_strncmp_7
    const char str1[] = "Hello";
    const char str2[] = "Hell";
    
    ck_assert_int_eq(s21_strncmp(str1, str2, 4), strncmp(str1, str2, 4));

#test s21_strncmp_8
    const char str1[] = "Hell";
    const char str2[] = "Hello";
    
    ck_assert_int_eq(s21_strncmp(str1, str2, 4), strncmp(str1, str2, 4));

#test s21_strncmp_9
    const char str1[] = "Lorem ipsum dolor sit amet, consectetur adipiscing elit.";
    const char str2[] = "Lorem ipsum dolor sit amet, consectetur adipiscing elit.";
    
    ck_assert_int_eq(s21_strncmp(str1, str2, 65), strncmp(str1, str2, 65));

#test s21_strncmp_10
    const char str1[] = "Lorem ipsum dolor sit amet, consectetur adipiscing elit.";
    const char str2[] = "Lorem ipsum dolor sit amet, consectetur adipiscing.";
    
    ck_assert_int_eq(s21_strncmp(str1, str2, 65), strncmp(str1, str2, 65));

#test s21_strncmp_11
    const char str1[] = "Lorem ipsum dolor sit amet, consectetur adipiscing elit.";
    const char str2[] = "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.";
    
    ck_assert_int_eq(s21_strncmp(str1, str2, 65), strncmp(str1, str2, 65));

#test s21_strncmp_12
    const char str1[] = "Lorem ipsum dolor sit amet, consectetur adipiscing elit.";
    const char str2[] = "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut enim ad minim veniam.";
    
    ck_assert_int_eq(s21_strncmp(str1, str2, 65), strncmp(str1, str2, 65));

#test s21_strncmp_13
    const char str1[] = "Lorem ipsum dolor sit amet, consectetur adipiscing elit.";
    const char str2[] = "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Quis autem vel eum iure reprehenderit qui in ea voluptate velit esse.";
    
    ck_assert_int_eq(s21_strncmp(str1, str2, 65), strncmp(str1, str2, 65));




#test s21_strstr_1
    const char str[] = "Hello, World!";
    const char substr[] = "World";
    ck_assert_str_eq(s21_strstr(str, substr), strstr(str, substr));

#test s21_strstr_2
    const char str[] = "Hello, World!";
    const char substr[] = "Hello";
    ck_assert_str_eq(s21_strstr(str, substr), strstr(str, substr));

#test s21_strstr_3
    const char str[] = "Hello, World!";
    const char substr[] = "!";
    ck_assert_str_eq(s21_strstr(str, substr), strstr(str, substr));

#test s21_strstr_4
    const char str[] = "Hello, World!";
    const char substr[] = "lo";
    ck_assert_str_eq(s21_strstr(str, substr), strstr(str, substr));

#test s21_strstr_5
    const char str[] = "Hello, World!";
    const char substr[] = "Goodbye";
    ck_assert_ptr_eq(s21_strstr(str, substr), strstr(str, substr));

#test s21_strstr_6
    const char str[] = "Hello, World!";
    const char substr[] = "";
    ck_assert_str_eq(s21_strstr(str, substr), strstr(str, substr));

#test s21_strstr_7
    const char str[] = "";
    const char substr[] = "Hello";
    ck_assert_ptr_eq(s21_strstr(str, substr), strstr(str, substr));

#test s21_strstr_8
    const char str[] = "";
    const char substr[] = "";
    ck_assert_str_eq(s21_strstr(str, substr), strstr(str, substr));





