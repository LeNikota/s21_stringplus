#include <string.h>
#include <stdio.h>
#include <stdlib.h>
#include "s21_string.h"

#test s21_memset_1
    char str[20] = "Hello, World!";
    
    ck_assert_str_eq(s21_memset(str, 'A', 5), memset(str, 'A', 5)); // Set first 5 characters to 'A'

#test s21_memset_2
    char str[20] = "Goodbye!";
    
    ck_assert_str_eq(s21_memset(str, 'B', 8), memset(str, 'B', 8)); // Set all characters to 'B'

#test s21_memset_3
    char str[20] = "abcdefg";
    
    ck_assert_str_eq(s21_memset(str, 'C', 3), memset(str, 'C', 3)); // Set first 3 characters to 'C'

#test s21_memset_4
    char str[20] = "1234567890";
    
    ck_assert_str_eq(s21_memset(str, '0', 10), memset(str, '0', 10)); // Set all characters to '0'

#test s21_memset_5
    char str[20] = "Hello, World!";
    
    s21_memset(str, 'X', 0);
    ck_assert_str_eq(str, "Hello, World!"); // Set 0 bytes, should remain unchanged

#test s21_memset_6
    char str[20] = "";
    
    ck_assert_str_eq(s21_memset(str, 'A', 0), memset(str, 'A', 0)); // Set 0 bytes, should remain empty

#test s21_memset_7
    char str[20] = "abcdef";
    
    s21_memset(str, 'Z', 6);
    ck_assert_str_eq(str, "ZZZZZZ"); // Set all characters to 'Z'

#test s21_memset_8
    char str[20] = "Hello, World!";
    
    s21_memset(str, ' ', 5);
    ck_assert_str_eq(str, "     , World!"); // Set first 5 characters to space
