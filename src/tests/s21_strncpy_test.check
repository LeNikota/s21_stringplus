#include <string.h>
#include <stdio.h>
#include <stdlib.h>
#include "s21_string.h"


#test s21_strcpy_1
    const char str1[] = "This is a long test text";
    char str2[100];
    char str3[100];

    strncpy(str2, str1, 5);
    s21_strncpy(str3, str1, 5);
    
    ck_assert_str_eq(str2, str3);

#test s21_strcpy_2
    const char str1[] = "This is a long test text";
    char str2[100];
    char str3[100];

    strncpy(str2, str1, 17);
    s21_strncpy(str3, str1, 17);
    
    ck_assert_str_eq(str2, str3);

#test s21_strcpy_3
    const char str1[] = "This is a long test text";
    char str2[100];
    char str3[100];

    strncpy(str2, str1, 80);
    s21_strncpy(str3, str1, 80);
    
    ck_assert_str_eq(str2, str3);

