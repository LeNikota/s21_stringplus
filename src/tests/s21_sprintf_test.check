#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <limits.h>
#include <float.h>
#include "s21_string.h"

#test s21_sprintf_integer_decimal
    char buffer[100];
    char expected[100];
    int number = 42;
    int count, s21_count;

    count = sprintf(expected, "Number: %d", number);
    s21_count = s21_sprintf(buffer, "Number: %d", number);

    ck_assert_str_eq(buffer, expected);
    ck_assert_int_eq(count, s21_count);

#test s21_sprintf_long_decimal
    char buffer[100];
    char expected[100];
    long number = 1234567890L;
    int count, s21_count;

    count = sprintf(expected, "Long Number: %ld", number);
    s21_count = s21_sprintf(buffer, "Long Number: %ld", number);

    ck_assert_str_eq(buffer, expected);
    ck_assert_int_eq(count, s21_count);

#test s21_sprintf_long_long_decimal
    char buffer[100];
    char expected[100];
    long long number = 1234567890123456789LL;
    int count, s21_count;

    count = sprintf(expected, "Long Long Number: %lld", number);
    s21_count = s21_sprintf(buffer, "Long Long Number: %lld", number);

    ck_assert_str_eq(buffer, expected);
    ck_assert_int_eq(count, s21_count);

#test s21_sprintf_integer
    char buffer[100];
