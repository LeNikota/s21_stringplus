#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include "s21_string.h"

#test s21_sprintf_integer_decimal
    char buffer[100];
    char expected[100];
    int number = 42;

    ck_assert_int_eq(s21_sprintf(buffer, "Number: %d", number), sprintf(expected, "Number: %d", number));
    ck_assert_str_eq(buffer, expected);

#test s21_sprintf_long_decimal
    char buffer[100];
    char expected[100];
    long number = 1234567890L;

    ck_assert_int_eq(s21_sprintf(buffer, "Long Number: %ld", number), sprintf(expected, "Long Number: %ld", number));
    ck_assert_str_eq(buffer, expected);

#test s21_sprintf_long_long_decimal
    char buffer[100];
    char expected[100];
    long long number = 1234567890123456789LL;

    ck_assert_int_eq(s21_sprintf(buffer, "Long Long Number: %lld", number), sprintf(expected, "Long Long Number: %lld", number));
    ck_assert_str_eq(buffer, expected);

#test s21_sprintf_integer
    char buffer[100];
    char expected[100];
    int number = 42;

    ck_assert_int_eq(s21_sprintf(buffer, "Number: %i", number), sprintf(expected, "Number: %i", number));
    ck_assert_str_eq(buffer, expected);

#test s21_sprintf_long_integer
    char buffer[100];
    char expected[100];
    long number = 1234567890L;

    ck_assert_int_eq(s21_sprintf(buffer, "Long Number: %li", number), sprintf(expected, "Long Number: %li", number));
    ck_assert_str_eq(buffer, expected);

#test s21_sprintf_long_long_integer
    char buffer[100];
    char expected[100];
    long long number = 1234567890123456789LL;

    ck_assert_int_eq(s21_sprintf(buffer, "Long Long Number: %lli", number), sprintf(expected, "Long Long Number: %lli", number));
    ck_assert_str_eq(buffer, expected);

#test s21_sprintf_string
    char buffer[100];
    char expected[100];
    const char *text = "Hello, World!";

    ck_assert_int_eq(s21_sprintf(buffer, "Text: %s", text), sprintf(expected, "Text: %s", text));
    ck_assert_str_eq(buffer, expected);

#test s21_sprintf_character
    char buffer[100];
    char expected[100];

    ck_assert_int_eq(s21_sprintf(buffer, "Character: %c%c%c", 'w', 'o', 'w'), sprintf(expected, "Character: %c%c%c",'w', 'o', 'w'));
    ck_assert_str_eq(buffer, expected);

#test s21_sprintf_n_flag
    char buffer[100];
    char expected[100];
    int count;
    int count_expected;
    int count_second;
    int count_expected_second;

    ck_assert_int_eq(s21_sprintf(buffer, "How much have you read %n", &count), sprintf(expected, "How much have you read %n", &count_expected));
    ck_assert_str_eq(buffer, expected);
    ck_assert_int_eq(count, count_expected);

    ck_assert_int_eq(s21_sprintf(buffer, "How much have you read %n, and how much now %n", &count, &count_second), sprintf(expected, "How much have you read %n, and how much now %n", &count_expected, &count_expected_second));
    ck_assert_str_eq(buffer, expected);
    ck_assert_int_eq(count, count_expected);
    ck_assert_int_eq(count_second, count_expected_second);