#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <limits.h>
#include "s21_string.h"

#test s21_sprintf_integer_decimal
    char buffer[100];
    char expected[100];
    int number = 42;

    ck_assert_int_eq(s21_sprintf(buffer, "Number: %d", number), sprintf(expected, "Number: %d", number));
    ck_assert_str_eq(buffer, expected);

#test s21_sprintf_long_decimal
    char buffer[100];
    char expected[100];
    long number = 1234567890L;

    ck_assert_int_eq(s21_sprintf(buffer, "Long Number: %ld", number), sprintf(expected, "Long Number: %ld", number));
    ck_assert_str_eq(buffer, expected);

#test s21_sprintf_long_long_decimal
    char buffer[100];
    char expected[100];
    long long number = 1234567890123456789LL;

    ck_assert_int_eq(s21_sprintf(buffer, "Long Long Number: %lld", number), sprintf(expected, "Long Long Number: %lld", number));
    ck_assert_str_eq(buffer, expected);

#test s21_sprintf_integer
    char buffer[100];
    char expected[100];
    int number = 42;

    ck_assert_int_eq(s21_sprintf(buffer, "Number: %i", number), sprintf(expected, "Number: %i", number));
    ck_assert_str_eq(buffer, expected);

#test s21_sprintf_long_integer
    char buffer[100];
    char expected[100];
    long number = 1234567890L;

    ck_assert_int_eq(s21_sprintf(buffer, "Long Number: %li", number), sprintf(expected, "Long Number: %li", number));
    ck_assert_str_eq(buffer, expected);

#test s21_sprintf_long_long_integer
    char buffer[100];
    char expected[100];
    long long number = 1234567890123456789LL;

    ck_assert_int_eq(s21_sprintf(buffer, "Long Long Number: %lli", number), sprintf(expected, "Long Long Number: %lli", number));
    ck_assert_str_eq(buffer, expected);

#test s21_sprintf_string
    char buffer[100];
    char expected[100];
    const char *text = "Hello, World!";

    ck_assert_int_eq(s21_sprintf(buffer, "Text: %s", text), sprintf(expected, "Text: %s", text));
    ck_assert_str_eq(buffer, expected);

#test s21_sprintf_character
    char buffer[100];
    char expected[100];

    ck_assert_int_eq(s21_sprintf(buffer, "Character: %c%c%c", 'w', 'o', 'w'), sprintf(expected, "Character: %c%c%c",'w', 'o', 'w'));
    ck_assert_str_eq(buffer, expected);

#test s21_sprintf_n_flag
    char buffer[100];
    char expected[100];
    int count;
    int count_expected;
    int count_second;
    int count_expected_second;

    ck_assert_int_eq(s21_sprintf(buffer, "How much have you read %n", &count), sprintf(expected, "How much have you read %n", &count_expected));
    ck_assert_str_eq(buffer, expected);
    ck_assert_int_eq(count, count_expected);

    ck_assert_int_eq(s21_sprintf(buffer, "How much have you read %n, and how much now %n", &count, &count_second), sprintf(expected, "How much have you read %n, and how much now %n", &count_expected, &count_expected_second));
    ck_assert_str_eq(buffer, expected);
    ck_assert_int_eq(count, count_expected);
    ck_assert_int_eq(count_second, count_expected_second);










#test s21_sprintf_unsigned_integer
    char buffer[100];
    char expected[100];
    unsigned int number = 42;

    ck_assert_int_eq(s21_sprintf(buffer, "Unsigned Number: %u", number), sprintf(expected, "Unsigned Number: %u", number));
    ck_assert_str_eq(buffer, expected); 
    
#test s21_sprintf_unsigned_integer_max
    char buffer[100];
    char expected[100];
    unsigned int number = INT_MAX;

    ck_assert_int_eq(s21_sprintf(buffer, "Max Unsigned Number: %u", number), sprintf(expected, "Max Unsigned Number: %u", number));
    ck_assert_str_eq(buffer, expected);


#test s21_sprintf_unsigned_long_integer_max
    char buffer[100];
    char expected[100];
    unsigned long number = ULONG_MAX; 

    ck_assert_int_eq(s21_sprintf(buffer, "Max Unsigned Long Number: %lu", number), sprintf(expected, "Max Unsigned Long Number: %lu", number));
    ck_assert_str_eq(buffer, expected);


#test s21_sprintf_unsigned_long_long_integer_max
    char buffer[100];
    char expected[100];
    unsigned long long number = ULLONG_MAX; 

    ck_assert_int_eq(s21_sprintf(buffer, "Max Unsigned Long Long Number: %llu", number), sprintf(expected, "Max Unsigned Long Long Number: %llu", number));
    ck_assert_str_eq(buffer, expected);





#test s21_sprintf_pointer_null
    char buffer[100];
    char expected[100];
    void *ptr = NULL;

    ck_assert_int_eq(s21_sprintf(buffer, "Pointer: %p", ptr), sprintf(expected, "Pointer: %p", ptr));
    ck_assert_str_eq(buffer, expected);

#test s21_sprintf_pointer_valid
    char buffer[100];
    char expected[100];
    int number = 42;
    void *ptr = &number;

    ck_assert_int_eq(s21_sprintf(buffer, "Pointer: %p", ptr), sprintf(expected, "Pointer: %p", ptr));
    ck_assert_str_eq(buffer, expected);

#test s21_sprintf_pointer_array
    char buffer[100];
    char expected[100];
    int array[5] = {1, 2, 3, 4, 5};
    void *ptr = array;

    ck_assert_int_eq(s21_sprintf(buffer, "Pointer to array: %p", ptr), sprintf(expected, "Pointer to array: %p", ptr));
    ck_assert_str_eq(buffer, expected);

#test s21_sprintf_pointer_function
    char buffer[100];
    char expected[100];
    void (*func_ptr)(void) = NULL;

    ck_assert_int_eq(s21_sprintf(buffer, "Function Pointer: %p", func_ptr), sprintf(expected, "Function Pointer: %p", func_ptr));
    ck_assert_str_eq(buffer, expected);

#test s21_sprintf_pointer_dynamic_memory
    char buffer[100];
    char expected[100];
    char *dynamic_ptr = malloc(10); // Allocate memory dynamically

    ck_assert_int_eq(s21_sprintf(buffer, "Dynamic Pointer: %p", dynamic_ptr), sprintf(expected, "Dynamic Pointer: %p", dynamic_ptr));
    ck_assert_str_eq(buffer, expected);

    free(dynamic_ptr); // Free the allocated memory

#test s21_sprintf_pointer_multiple
    char buffer[100];
    char expected[100];
    int a = 10, b = 20;
    void *ptr_a = &a;
    void *ptr_b = &b;

    ck_assert_int_eq(s21_sprintf(buffer, "Pointers: %p and %p", ptr_a, ptr_b), sprintf(expected, "Pointers: %p and %p", ptr_a, ptr_b));
    ck_assert_str_eq(buffer, expected);
