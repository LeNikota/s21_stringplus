    count = sprintf(expected, "Max Unsigned Long Long in Octal: %llo", number);
    s21_count = s21_sprintf(buffer, "Max Unsigned Long Long in Octal: %llo", number);

    ck_assert_str_eq(buffer, expected);
    ck_assert_int_eq(count, s21_count);

