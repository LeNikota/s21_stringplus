#test s21_sprintf_pointer_null
    char buffer[100];
    char expected[100];
    void *ptr = NULL;
    int count, s21_count;

    count = sprintf(expected, "Pointer: %p", ptr);
    s21_count = s21_sprintf(buffer, "Pointer: %p", ptr);

    ck_assert_str_eq(buffer, expected);
    ck_assert_int_eq(count, s21_count);

#test s21_sprintf_pointer_valid
    char buffer[100];
    char expected[100];
    int number = 42;
    void *ptr = &number;
    int count, s21_count;

    count = sprintf(expected, "Pointer: %p", ptr);
    s21_count = s21_sprintf(buffer, "Pointer: %p", ptr);

    ck_assert_str_eq(buffer, expected);
    ck_assert_int_eq(count, s21_count);

#test s21_sprintf_pointer_array
    char buffer[100];
    char expected[100];
    int array[5] = {1, 2, 3, 4, 5};
    void *ptr = array;
    int count, s21_count;

    count = sprintf(expected, "Pointer to array: %p", ptr);
    s21_count = s21_sprintf(buffer, "Pointer to array: %p", ptr);

    ck_assert_str_eq(buffer, expected);
    ck_assert_int_eq(count, s21_count);

#test s21_sprintf_pointer_function
    char buffer[100];
    char expected[100];
    void (*func_ptr)(void) = NULL;
    int count, s21_count;

    count = sprintf(expected, "Function Pointer: %p", func_ptr);
    s21_count = s21_sprintf(buffer, "Function Pointer: %p", func_ptr);

    ck_assert_str_eq(buffer, expected);
    ck_assert_int_eq(count, s21_count);

#test s21_sprintf_pointer_dynamic_memory
    char buffer[100];
    char expected[100];
    char *dynamic_ptr = malloc(10);
    int count, s21_count;

    count = sprintf(expected, "Dynamic Pointer: %p", dynamic_ptr);
    s21_count = s21_sprintf(buffer, "Dynamic Pointer: %p", dynamic_ptr);

    ck_assert_str_eq(buffer, expected);
    ck_assert_int_eq(count, s21_count);

    free(dynamic_ptr);

#test s21_sprintf_pointer_multiple
    char buffer[100];
    char expected[100];
    int a = 10, b = 20;
    void *ptr_a = &a;
    void *ptr_b = &b;
    int count, s21_count;

    count = sprintf(expected, "Pointers: %p and %p", ptr_a, ptr_b);
    s21_count = s21_sprintf(buffer, "Pointers: %p and %p", ptr_a, ptr_b);

    ck_assert_str_eq(buffer, expected);
    ck_assert_int_eq(count, s21_count);

