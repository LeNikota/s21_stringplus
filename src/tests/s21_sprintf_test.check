    #test s21_sprintf_unsigned_integer_octal
    char buffer[100];
    char expected[100];
    unsigned int number = 42;
    int count, s21_count;

    count = sprintf(expected, "Unsigned Number in Octal: %o", number);
    s21_count = s21_sprintf(buffer, "Unsigned Number in Octal: %o", number);

    ck_assert_str_eq(buffer, expected);
    ck_assert_int_eq(count, s21_count);

    #test s21_sprintf_unsigned_long_integer_octal_max
    char buffer[100];
    char expected[100];
    unsigned long number = ULONG_MAX; // Maximum value for unsigned long
    int count, s21_count;

    count = sprintf(expected, "Max Unsigned Long in Octal: %lo", number);
    s21_count = s21_sprintf(buffer, "Max Unsigned Long in Octal: %lo", number);

    ck_assert_str_eq(buffer, expected);
    ck_assert_int_eq(count, s21_count);

