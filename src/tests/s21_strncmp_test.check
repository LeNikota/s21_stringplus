#include <string.h>
#include <stdio.h>
#include <stdlib.h>
#include "s21_string.h"

#test s21_strncmp_1
    const char str1[] = "Hello";
    const char str2[] = "Hello";
    
    ck_assert_int_eq(s21_strncmp(str1, str2, 5), strncmp(str1, str2, 5));

#test s21_strncmp_2
    const char str1[] = "Hello";
    const char str2[] = "World";
    
    ck_assert_int_eq(s21_strncmp(str1, str2, 5), strncmp(str1, str2, 5));

#test s21_strncmp_4
    const char str1[] = "Hello";
    const char str2[] = "Hello, World";
    
    ck_assert_int_eq(s21_strncmp(str1, str2, 10), strncmp(str1, str2, 10));

#test s21_strncmp_5
    const char str1[] = "Hello, World";
    const char str2[] = "Hello";
    
    ck_assert_int_eq(s21_strncmp(str1, str2, 10), strncmp(str1, str2, 10));

#test s21_strncmp_6
    const char str1[] = "Hello";
    const char str2[] = "Hello";
    
    ck_assert_int_eq(s21_strncmp(str1, str2, 0), strncmp(str1, str2, 0));

#test s21_strncmp_7
    const char str1[] = "Hello";
    const char str2[] = "Hell";
    
    ck_assert_int_eq(s21_strncmp(str1, str2, 4), strncmp(str1, str2, 4));

#test s21_strncmp_8
    const char str1[] = "Hell";
    const char str2[] = "Hello";
    
    ck_assert_int_eq(s21_strncmp(str1, str2, 4), strncmp(str1, str2, 4));

#test s21_strncmp_9
    const char str1[] = "Lorem ipsum dolor sit amet, consectetur adipiscing elit.";
    const char str2[] = "Lorem ipsum dolor sit amet, consectetur adipiscing elit.";
    
    ck_assert_int_eq(s21_strncmp(str1, str2, 65), strncmp(str1, str2, 65));

#test s21_strncmp_10
    const char str1[] = "Lorem ipsum dolor sit amet, consectetur adipiscing elit.";
    const char str2[] = "Lorem ipsum dolor sit amet, consectetur adipiscing.";
    
    ck_assert_int_eq(s21_strncmp(str1, str2, 65), strncmp(str1, str2, 65));

#test s21_strncmp_11
    const char str1[] = "Lorem ipsum dolor sit amet, consectetur adipiscing elit.";
    const char str2[] = "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.";
    
    ck_assert_int_eq(s21_strncmp(str1, str2, 65), strncmp(str1, str2, 65));

#test s21_strncmp_12
    const char str1[] = "Lorem ipsum dolor sit amet, consectetur adipiscing elit.";
    const char str2[] = "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut enim ad minim veniam.";
    
    ck_assert_int_eq(s21_strncmp(str1, str2, 65), strncmp(str1, str2, 65));

#test s21_strncmp_13
    const char str1[] = "Lorem ipsum dolor sit amet, consectetur adipiscing elit.";
    const char str2[] = "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Quis autem vel eum iure reprehenderit qui in ea voluptate velit esse.";
    
    ck_assert_int_eq(s21_strncmp(str1, str2, 65), strncmp(str1, str2, 65));
