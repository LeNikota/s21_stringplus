#include <string.h>
#include <stdio.h>
#include <stdlib.h>
#include "s21_string.h"

#test s21_strlen_1
    const char str[] = "";
    
    ck_assert_int_eq(  strlen(str), s21_strlen(str));

#test s21_strlen_2
    const char str[] = "Hello world";
    
    ck_assert_int_eq(  strlen(str), s21_strlen(str));

#test s21_strlen_3
    const char str[] = "Cotton Eye Joe";
    
    ck_assert_int_eq(  strlen(str), s21_strlen(str));
